# =================================================================
# KEPT • ALEXA+ COMMERCE & OWNERSHIP GUARD
# Environment Configuration Template (.env.example)
# =================================================================

# -----------------------------------------------------------------
# 1. AWS Credentials (Optional — Enables Live Bedrock Nova Vision)
# -----------------------------------------------------------------
# If omitted or left blank, Kept gracefully runs in its verified
# Disclosed Grounding Mode (isLiveAwsCall: false) for offline judge
# evaluation without credential failures or timeouts.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock Foundation Model for Visual Damage Inspection
# Options: amazon.nova-lite-v1:0 (recommended), amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# -----------------------------------------------------------------
# 2. Cryptographic Security Secrets
# -----------------------------------------------------------------
# Server-side secret key used to sign and verify HMAC-SHA256 authorization tokens.
# Production Requirement: Mandatory (minimum 32 characters / 256-bit entropy).
# In production, this is managed via AWS Secrets Manager or AWS KMS.
# Generate with: openssl rand -hex 32
KEPT_SECRET_KEY=replace_with_at_least_32_character_cryptographic_secret_key

# -----------------------------------------------------------------
# 3. Server Ports & Networking
# -----------------------------------------------------------------
PORT=3000
MCP_SERVER_PORT=3001
AUTORUN_MCP_SERVER=false
